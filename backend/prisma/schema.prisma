generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                 @id @default(uuid())
  name                  String
  email                 String                 @unique
  password              String
  role                  Role                   @default(parent)
  department            String
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  status                UserStatus             @default(active)
  phone                 String?
  roleGroupId           String?
  roleGroup             RoleGroup?             @relation(fields: [roleGroupId], references: [id], onDelete: SetNull)
  groups                GroupMember[]
  sentMessages          Message[]              @relation("SentMessages")
  notifications         Notification[]
  fcmTokens             FCMToken[]
  announcements         Announcement[]         @relation("AnnouncementAuthor")
  studentProfile        StudentProfile?
  teacherProfile        TeacherProfile?
  profileUpdateRequests ProfileUpdateRequest[]
  leaveApplications     LeaveApplication[]
  timetableEntries      TimetableEntry[]       @relation("TeacherTimetable")
  absentSubstitutions   Substitution[]         @relation("AbsentTeacher")
  substituteSubstitutions Substitution[]       @relation("SubstituteTeacher")
  wingCoordinator       Wing[]                 @relation("WingCoordinator")
}

model RoleGroup {
  id          String   @id @default(uuid())
  name        String   @unique
  permissions Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model TeacherProfile {
  id             String @id @default(uuid())
  userId         String @unique
  employeeId     String @unique
  designation    String
  specialization String
  phone          String?
  dateOfBirth    String?
  weddingDate    String?
  user           User   @relation(fields: [userId], references: [id])
}

model StudentProfile {
  id                   String @id @default(uuid())
  userId               String @unique
  studentId            String @unique
  class                String
  section              String
  phone                String?
  admissionNo          String?
  applicationNo        String?
  gender               String?
  dob                  String?
  birthCertNo          String?
  nationality          String?
  religion             String?
  community            String?
  bloodGroup           String?
  presentSchool        String?
  previousGrade        String?
  boardOfEducation     String?
  motherTongue         String?
  fatherName           String?
  fatherContact        String?
  fatherEmail          String?
  fatherEducation      String?
  fatherOccupation     String?
  fatherOrganization   String?
  fatherDesignation    String?
  fatherOfficeAddress  String?
  motherName           String?
  motherContact        String?
  motherEmail          String?
  motherEducation      String?
  motherOccupation     String?
  motherOrganization   String?
  motherDesignation    String?
  motherOfficeAddress  String?
  user                 User   @relation(fields: [userId], references: [id])
}

model Group {
  id          String        @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  messages    Message[]
}

model GroupMember {
  id        String   @id @default(uuid())
  userId    String
  groupId   String
  role      String   @default("member")
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, groupId])
}

model Message {
  id        String   @id @default(uuid())
  text      String
  senderId  String
  groupId   String
  createdAt DateTime @default(now())
  group     Group    @relation(fields: [groupId], references: [id])
  sender    User     @relation("SentMessages", fields: [senderId], references: [id])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String   @default("info") // message, alert, info
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model FCMToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  device    String?  // web, mobile
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  authorId  String
  target    String   @default("all") // all, parents, staff
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
}

model LeaveApplication {
  id          String   @id @default(uuid())
  userId      String
  studentName String
  class       String
  section     String
  startDate   String
  endDate     String
  reason      String
  documentUrl String?
  status      String   @default("pending")
  adminNote   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ProfileUpdateRequest {
  id        String   @id @default(uuid())
  userId    String
  changes   Json
  status    String   @default("pending")
  adminNote String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SchoolSettings {
  id           String   @id @default("singleton")
  name         String   @default("SNS Academy")
  academicYear String   @default("2026-2027")
  timezone     String   @default("Asia/Kolkata")
  contactEmail String   @default("")
  contactPhone String   @default("")
  address      String   @default("")
  // Section 6 - medium of instruction
  mediumOfInstruction String @default("English")
  secondLanguage      String @default("")
  board               String @default("")
  // Attendance rules (Phase B)
  lateAfterMinutes       Int @default(15)
  minAttendancePercent   Int @default(75)
  consecutiveAbsenceAlerts Int @default(3)
  monthlyReportDay       Int @default(1)
  updatedAt    DateTime @updatedAt
}

// Section 12 - academic calendar. Persisted instead of the hardcoded
// INITIAL_EVENTS the calendar page used to ship with.
model AcademicEvent {
  id          String   @id @default(uuid())
  title       String
  date        String   // YYYY-MM-DD (single-day events)
  endDate     String?  // optional, for multi-day spans
  time        String   @default("")
  type        String   @default("academic") // academic | holiday | event | exam
  location    String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([type])
}

// Section 17 - school image gallery. Rows point at files served from
// /files/gallery/... written by UploadsModule.
model SchoolImage {
  id        String   @id @default(uuid())
  url       String
  caption   String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([sortOrder])
}

model TimetableEntry {
  id        String   @id @default(uuid())
  day       String   // Monday, Tuesday, etc.
  period    Int      // 1, 2, 3...
  startTime String
  endTime   String
  class     String
  section   String
  subject   String
  room      String   @default("")
  teacherId String
  teacher   User     @relation("TeacherTimetable", fields: [teacherId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One slot per class-section per period - the API rejects duplicates
  // before this, but the constraint makes it impossible to lose.
  @@unique([day, period, class, section])
  @@index([class, section])
}

model Substitution {
  id               String   @id @default(uuid())
  date             String   // YYYY-MM-DD
  period           Int
  absentTeacherId  String
  absentTeacher    User     @relation("AbsentTeacher", fields: [absentTeacherId], references: [id])
  substituteTeacherId String
  substituteTeacher User     @relation("SubstituteTeacher", fields: [substituteTeacherId], references: [id])
  status           String   @default("pending") // pending, approved, completed
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Attendance {
  id          String   @id @default(uuid())
  studentId   String
  date        String   // YYYY-MM-DD
  status      String   // P, A, L, H
  reason      String?
  class       String
  section     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, date])
}

model Homework {
  id          String   @id @default(uuid())
  title       String
  description String
  subject     String
  dueDate     String
  class       String
  section     String
  teacherId   String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ExamResult {
  id          String   @id @default(uuid())
  studentId   String
  term        String
  subject     String
  internal    Int
  exam        Int
  total       Int
  grade       String
  remarks     String?
  academicYear String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([studentId, term, subject])
}

model ExamSchedule {
  id          String   @id @default(uuid())
  class       String
  section     String
  subject     String
  examDate    String
  startTime   String
  duration    String?
  hall        String?
  term        String
  academicYear String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromotionLog {
  id               String   @id @default(uuid())
  batchId          String   // Groups all promotions in one batch for rollback
  studentProfileId String   // FK to StudentProfile.id
  studentId        String   // The permanent student ID (never changes)
  studentName      String
  fromClass        String
  fromSection      String
  toClass          String
  toSection        String
  fromAcademicYear String   // e.g. "2025-2026"
  toAcademicYear   String   // e.g. "2026-2027"
  status           String   // promoted, failed, transferred, discontinued, graduated
  rolledBack       Boolean  @default(false)
  rolledBackAt     DateTime?
  promotedAt       DateTime @default(now())
  promotedBy       String   // admin userId who performed it
}

enum Role {
  superadmin
  admin
  leader
  // Added in Phase B - school leadership roles. Both are additive enum
  // values, so existing rows and tokens are unaffected.
  principal
  coordinator
  teacher
  parent
}

// ---------------------------------------------------------------------------
// Phase A - academic foundation
// Sections 3, 4, 5, 6, 7, 10 and 11 of "New ERP school.xlsx"
// ---------------------------------------------------------------------------

/// Section 3 + 4: school wings and their coordinators.
model Wing {
  id        String   @id @default(uuid())
  name      String   @unique // Senior Secondary, Secondary, Midwing, ...
  sortOrder Int      @default(0)
  gradeRange String  @default("") // "Grade 11 and Grade 12"
  coordinatorName String @default("") // display name until linked to an account
  coordinatorId   String?
  coordinator     User?   @relation("WingCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull) // one teacher may coordinate several wings
  classes   SchoolClass[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Section 5: classes. `name` is the display label from the spreadsheet
/// ("Grade X"), `code` is the short form already used by existing records
/// ("10") so current student/homework/timetable rows keep matching.
model SchoolClass {
  id        String   @id @default(uuid())
  name      String   @unique // "Grade X", "PRE KG"
  code      String   @unique // "10", "PRE KG"
  sortOrder Int      @default(0)
  wingId    String?
  wing      Wing?    @relation(fields: [wingId], references: [id], onDelete: SetNull)
  sections  ClassSection[]
  subjects  ClassSubject[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ClassSection {
  id      String @id @default(uuid())
  classId String
  name    String // "A", "B", ...
  class   SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
}

/// Section 7: subject catalogue.
model Subject {
  id        String   @id @default(uuid())
  name      String   @unique
  type      String   @default("scholastic") // scholastic | co-scholastic | assessment
  sortOrder Int      @default(0)
  classes   ClassSubject[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Which subjects a class offers. `optional` marks choice sets
/// (Language II Tamil/Hindi/French - a student picks one).
model ClassSubject {
  id        String  @id @default(uuid())
  classId   String
  subjectId String
  sortOrder Int     @default(0)
  optional  Boolean @default(false)
  class     SchoolClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([classId, subjectId])
}

/// Section 11: configurable grading scale (replaces the hardcoded
/// calcGrade() in exams.service.ts).
model GradingScale {
  id        String      @id @default(uuid())
  name      String      @unique
  isDefault Boolean     @default(false)
  passMark  Int         @default(33)
  bands     GradeBand[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
}

model GradeBand {
  id        String @id @default(uuid())
  scaleId   String
  minMark   Int
  maxMark   Int
  grade     String // "A1", "A2", ...
  remark    String @default("")
  sortOrder Int    @default(0)
  scale     GradingScale @relation(fields: [scaleId], references: [id], onDelete: Cascade)

  @@unique([scaleId, minMark])
}

/// Section 10: exam types (Periodic Test 1-3, Term 1-2, Preboard, Annual).
model ExamType {
  id        String   @id @default(uuid())
  name      String // "Periodic Test 1"
  appliesTo String   @default("All grades (I - XII)")
  isTerm    Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserStatus {
  active
  away
  inactive
}
